{
  // PhoneBox settings. Easiest to edit from the tray icon > Settings (http://127.0.0.1:8765).
  // Manual edits are picked up on the next request; no restart needed.

  // Only use the phone with this serial number (null = every connected Android device)
  "deviceSerial": null,
  // Path to adb.exe (null = searched in PATH, the Android SDK and winget locations)
  "adbPath": null,

  // Weather location (Open-Meteo, no API key required)
  "weather": { "city": "Tallinn", "lat": 59.437, "lon": 24.745 },

  // Night mode: between these times the screen dims and only the clock stays. Tap to wake it for 30 s.
  "night": { "enabled": true, "start": "00:30", "end": "07:30", "brightness": 0.02 },

  // Clock seconds, return to the first page after N idle seconds (0 = never), vibrate on session events
  "display": { "showSeconds": true, "idleReturnSec": 90, "vibrate": true },

  // Pages in the order they appear on the phone. Unknown pages are ignored, missing ones are appended.
  "pages": [
    { "type": "home",   "enabled": true, "options": { "weather": true, "media": true, "tiles": ["cpu", "gpu", "ram", "net"] } },
    { "type": "ai",     "enabled": true, "options": { "claude": true, "codex": true } },
    { "type": "work",   "enabled": true, "options": { "sessions": true, "github": true } },
    { "type": "system", "enabled": true },
    { "type": "procs",  "enabled": true, "options": { "allowKill": true } },
    { "type": "deck",   "enabled": true, "options": { "columns": 4 } }
  ],

  // Shortcut keys. The phone only sends the "id"; commands live in this file only.
  // cmd: a program, a URL / shell: / ms-settings: address, or builtin:lock | builtin:monitor-off | builtin:mute
  "shortcuts": [
    { "id": "terminal",   "label": "Terminal",     "icon": "⌨️", "color": "#4b5563", "cmd": "wt.exe" },
    { "id": "explorer",   "label": "Files",        "icon": "📁", "color": "#e5b84b", "cmd": "explorer.exe" },
    { "id": "vscode",     "label": "VS Code",      "icon": "📝", "color": "#2f80ed", "cmd": "shell:AppsFolder\\Microsoft.VisualStudioCode" },
    { "id": "browser",    "label": "Browser",      "icon": "🌐", "color": "#0ea5e9", "cmd": "https://github.com" },
    { "id": "spotify",    "label": "Spotify",      "icon": "🎧", "color": "#1db954", "cmd": "shell:AppsFolder\\SpotifyAB.SpotifyMusic_zpdnekdrzrea0!Spotify" },
    { "id": "calc",       "label": "Calculator",   "icon": "🧮", "color": "#64748b", "cmd": "calc.exe" },
    { "id": "settings",   "label": "Settings",     "icon": "⚙️", "color": "#94a3b8", "cmd": "ms-settings:" },
    { "id": "snip",       "label": "Snip",         "icon": "✂️", "color": "#14b8a6", "cmd": "ms-screenclip:" },
    { "id": "taskmgr",    "label": "Task Manager", "icon": "📊", "color": "#22c55e", "cmd": "taskmgr.exe" },
    { "id": "mute",       "label": "Mute",         "icon": "🔇", "color": "#f59e0b", "cmd": "builtin:mute" },
    { "id": "monitoroff", "label": "Screen Off",   "icon": "🌙", "color": "#6366f1", "cmd": "builtin:monitor-off" },
    { "id": "lock",       "label": "Lock",         "icon": "🔒", "color": "#ef4444", "cmd": "builtin:lock" }
  ]
}
